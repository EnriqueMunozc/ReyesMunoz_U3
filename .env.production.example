APP_NAME=Cuentahorro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL HTTPS del subdominio asignado por el proveedor.
APP_URL=https://NOMBRE_DE_CUENTA.alwaysdata.net
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
BUSINESS_TIMEZONE=America/Mexico_City
DB_CONNECTION=mysql
DB_HOST=mysql-NOMBRE_DE_CUENTA.alwaysdata.net
DB_PORT=3306
DB_DATABASE=NOMBRE_DE_CUENTA_cuentahorro
DB_USERNAME=NOMBRE_DE_CUENTA_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7
MAIL_MAILER=log
FRANKFURTER_URL=https://api.frankfurter.dev
