{
  "info": {
    "name": "Cuentahorro · Finanzas y API",
    "description": "Ejecutar en orden sobre datos de demostración propios. Registrar usuario por web y completar email/password localmente. La carpeta 5 requiere other_token de un segundo usuario. El conversor puede responder 503 si no existe una tasa utilizable. No exportar variables con tokens o contraseñas reales. No incluye transferencias ni presupuestos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const p = Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:'America/Mexico_City',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date()).map(x=>[x.type,x.value]));",
          "pm.environment.set('fecha',`${p.year}-${p.month}-${p.day}`);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Obtener token (usuario ya registrado en web)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"nombre_dispositivo\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
                  "if(pm.response.code===201) { pm.environment.set('token',pm.response.json().data.token); pm.expect(pm.response.json().data.expires_at).to.be.a('string'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin autenticación: 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/cuentas",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401',()=>pm.response.to.have.status(401));",
                  "pm.test('Respuesta JSON',()=>pm.response.to.be.json);"
                ]
              }
            }
          ]
        },
        {
          "name": "Credenciales incorrectas: 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"incorrecta-solo-prueba\",\n  \"nombre_dispositivo\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401',()=>pm.response.to.have.status(401));",
                  "pm.test('Respuesta JSON',()=>pm.response.to.be.json);"
                ]
              }
            }
          ]
