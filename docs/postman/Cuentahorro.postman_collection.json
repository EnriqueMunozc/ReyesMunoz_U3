              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tasa disponible o indisponibilidad explícita',()=>pm.expect([200,503]).to.include(pm.response.code));",
                  "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
                  "if(pm.response.code===200) { const d=pm.response.json().data; pm.test('Tasa decimal y metadatos',()=>{ pm.expect(d.tasa).to.be.a('string').and.match(/^\\d+\\.\\d{18}$/); pm.expect(['consulta','cache','respaldo']).to.include(d.estado); pm.expect(d.fecha_referencia).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(d.consultado_en).to.be.a('string'); pm.expect(d.proveedor).to.eql('Frankfurter'); pm.expect(d.informativa).to.eql(true); if(d.resultado!==null) { pm.expect(d.resultado).to.be.a('string').and.match(/^\\d+\\.\\d{2}$/); pm.expect(d.importe).to.be.a('string'); } }); }",
                  "if(pm.response.code===503) { pm.test('Sin tasa utilizable',()=>pm.expect(pm.response.json().code).to.eql('tipo_cambio_no_disponible')); }"
                ]
              }
            }
          ]
